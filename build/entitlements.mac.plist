<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app records audio to transcribe it locally. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Electron needs these under the hardened runtime; without them the
       renderer fails to start once the app is signed. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The transcriber is a separate executable this app launches. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Deliberately NOT requested: network access. The app makes no network
       requests, and omitting the entitlement is what makes that enforceable
       rather than merely claimed. -->
</dict>
</plist>
